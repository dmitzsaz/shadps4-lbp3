+static inline uint
+poly_ballot_word(uint4 ballot, uint word)
+{
+   if (word == 0)
+      return ballot.x;
+   if (word == 1)
+      return ballot.y;
+   if (word == 2)
+      return ballot.z;
+   return ballot.w;
+}
+
+/* Return the last set lane at or below max_lane, or UINT32_MAX when empty. */
+static inline uint
+poly_ballot_find_msb_upto(uint4 ballot, uint max_lane)
+{
+   int word = max_lane >> 5;
+   uint bit = max_lane & 31;
+
+   for (; word >= 0; --word) {
+      uint value = poly_ballot_word(ballot, word);
+      if (bit != 31)
+         value &= (1u << (bit + 1)) - 1u;
+
+      if (value)
+         return (word * 32) + (31 - clz(value));
+
+      bit = 31;
+   }
+
+   return UINT32_MAX;
+}
