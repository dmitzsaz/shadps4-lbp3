+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   uint carried_segment_start = 0;
+   uint triangle_count = 0;
+   for (uint tile_base = 0; tile_base < count; tile_base += wg_size) {
+      const uint source_pos = tile_base + tid;
+      const bool in_bounds = source_pos < count;
+      const uint value = in_bounds
+                            ? poly_load_index(in_ptr, in_range_el, source_pos,
+                                              in_index_size_B)
+                            : 0;
+      const bool restart = in_bounds && value == restart_index;
+      const uint segment_start = poly_work_group_segment_start(
+         restart, tile_base, carried_segment_start, ballot_scratch);
