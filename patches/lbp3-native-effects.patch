+static inline uint
+poly_ballot_word(uint4 ballot, uint word)
+{
+   if (word == 0)
+      return ballot.x;
+   if (word == 1)
+      return ballot.y;
+   if (word == 2)
+      return ballot.z;
+   return ballot.w;
+}
+
+/* Return the last set lane at or below max_lane, or UINT32_MAX when empty. */
+static inline uint
+poly_ballot_find_msb_upto(uint4 ballot, uint max_lane)
+{
+   int word = max_lane >> 5;
+   uint bit = max_lane & 31;
+
+   for (; word >= 0; --word) {
+      uint value = poly_ballot_word(ballot, word);
+      if (bit != 31)
+         value &= (1u << (bit + 1)) - 1u;
+
+      if (value)
+         return (word * 32) + (31 - clz(value));
+
+      bit = 31;
+   }
+
+   return UINT32_MAX;
+}
+
+/*
+ * Return the first source position in the current restart-delimited segment.
+ * Unlike poly_work_group_first_true(), this performs a fixed amount of work
+ * for a whole tile. Restart-dense streams therefore cost O(input count), not
+ * O(restart count * workgroup size).
+ */
+static inline uint
+poly_work_group_segment_start(bool restart, uint tile_base,
+                              uint carried_segment_start,
+                              local void *scratch)
+{
+   const uint sg_size = get_sub_group_size();
+   const uint sg_id = get_sub_group_id();
+   const uint lane = get_sub_group_local_id();
+
+   uint4 ballot = sub_group_ballot(restart);
+
+   /* Do not overwrite ballot storage until every subgroup has finished the
+    * previous tile, then publish one complete ballot per subgroup. */
+   barrier(CLK_LOCAL_MEM_FENCE);
+   if (lane == 0)
+      poly_store_local_ballot_arr(scratch, sg_id, ballot);
+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   int search_sg = sg_id;
+   uint latest_lane = poly_ballot_find_msb_upto(ballot, lane);
+   while (latest_lane == UINT32_MAX && search_sg > 0) {
+      --search_sg;
+      ballot = poly_load_local_ballot_arr(scratch, search_sg);
+      latest_lane = poly_ballot_find_msb_upto(ballot, sg_size - 1);
+   }
+
+   if (latest_lane == UINT32_MAX)
+      return carried_segment_start;
+
+   return tile_base + (search_sg * sg_size) + latest_lane + 1;
+}
