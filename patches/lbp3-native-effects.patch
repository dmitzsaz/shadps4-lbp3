+/*
+ * Restart-aware TriangleFan conversion with cost bounded by input length.
+ *
+ * The first pass classifies each source index by the most recent restart,
+ * counts valid triangles, and allocates the exact output size. Empty streams
+ * publish a zero indirect count without consuming generated-geometry heap.
+ * The second pass repeats the classification and emits compact triangles.
+ */
+static inline void
+poly_unroll_triangle_fan_linear(global uint32_t *out_draw,
+                                global struct poly_heap *heap,
+                                constant uint *in_draw,
+                                uint64_t index_buffer,
+                                uint32_t index_buffer_range_el,
+                                uint32_t in_index_size_B,
+                                uint32_t out_index_size_B,
+                                uint32_t restart_index,
+                                uint32_t flatshade_first,
+                                local void *ballot_scratch,
+                                local uint *scan_scratch,
+                                local uint *shared_segment_start,
+                                local uintptr_t *shared_out_ptr)
+{
+   const uint tid = cl_local_id.x;
+   const uint wg_size = cl_local_size.x;
+   const uint count = in_draw[0];
+
+   const uintptr_t in_ptr = (uintptr_t)(poly_index_buffer(
+      index_buffer, index_buffer_range_el, in_draw[2], in_index_size_B));
+   const uint in_range_el = poly_index_buffer_range_el(
+      index_buffer_range_el, in_draw[2]);
+
+   if (tid == 0) {
+      const uint vertex_offset_idx = in_index_size_B > 0 ? 3 : 2;
+      out_draw[0] = 0;
+      out_draw[1] = in_draw[1];
+      out_draw[2] = 0;
+      out_draw[3] = in_draw[vertex_offset_idx];
+      out_draw[4] = in_draw[vertex_offset_idx + 1];
+      *shared_segment_start = 0;
+      *shared_out_ptr = 0;
+   }
+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   uint carried_segment_start = 0;
+   uint triangle_count = 0;
+   for (uint tile_base = 0; tile_base < count; tile_base += wg_size) {
+      const uint source_pos = tile_base + tid;
+      const bool in_bounds = source_pos < count;
+      const uint value = in_bounds
+                            ? poly_load_index(in_ptr, in_range_el, source_pos,
+                                              in_index_size_B)
+                            : 0;
+      const bool restart = in_bounds && value == restart_index;
+      const uint segment_start = poly_work_group_segment_start(
+         restart, tile_base, carried_segment_start, ballot_scratch);
+      const bool valid = in_bounds && !restart &&
+                         source_pos >= segment_start &&
+                         source_pos - segment_start >= 2;
+
+      const uint2 scan = poly_work_group_scan_inclusive_add(valid, scan_scratch);
+      triangle_count += scan.y;
+
+      if (tid == wg_size - 1)
+         *shared_segment_start = segment_start;
+      barrier(CLK_LOCAL_MEM_FENCE);
+      carried_segment_start = *shared_segment_start;
+   }
+
+   if (tid == 0) {
+      out_draw[0] = triangle_count * 3;
+      if (triangle_count) {
+         const uint alloc_size = triangle_count * 3 * out_index_size_B;
+         const uint out_offset = poly_heap_alloc_offs(heap, alloc_size);
+         out_draw[2] = out_offset / out_index_size_B;
+         *shared_out_ptr = (uintptr_t)((global uchar *)heap->base + out_offset);
+      }
+      *shared_segment_start = 0;
+   }
+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   if (triangle_count == 0)
+      return;
+
+   const uintptr_t out_ptr = *shared_out_ptr;
+   carried_segment_start = 0;
+   uint output_triangle_base = 0;
+   for (uint tile_base = 0; tile_base < count; tile_base += wg_size) {
+      const uint source_pos = tile_base + tid;
+      const bool in_bounds = source_pos < count;
+      const uint current = in_bounds
+                              ? poly_load_index(in_ptr, in_range_el, source_pos,
+                                                in_index_size_B)
+                              : 0;
+      const bool restart = in_bounds && current == restart_index;
+      const uint segment_start = poly_work_group_segment_start(
+         restart, tile_base, carried_segment_start, ballot_scratch);
+      const bool valid = in_bounds && !restart &&
+                         source_pos >= segment_start &&
+                         source_pos - segment_start >= 2;
+
+      const uint2 scan = poly_work_group_scan_inclusive_add(valid, scan_scratch);
+      if (valid) {
+         const uint anchor = poly_load_index(in_ptr, in_range_el, segment_start,
+                                             in_index_size_B);
+         const uint previous = poly_load_index(in_ptr, in_range_el, source_pos - 1,
+                                               in_index_size_B);
+         const uint output = (output_triangle_base + scan.x - 1) * 3;
+
+         if (flatshade_first) {
+            /* Vulkan first-provoking fan: (previous, current, anchor). */
+            poly_store_index(out_ptr, out_index_size_B, output + 0, previous);
+            poly_store_index(out_ptr, out_index_size_B, output + 1, current);
+            poly_store_index(out_ptr, out_index_size_B, output + 2, anchor);
+         } else {
+            /* Metal is first-provoking. Rotate (anchor, previous, current) to
+             * (current, anchor, previous), preserving winding while making the
+             * original last vertex provoking. */
+            poly_store_index(out_ptr, out_index_size_B, output + 0, current);
+            poly_store_index(out_ptr, out_index_size_B, output + 1, anchor);
+            poly_store_index(out_ptr, out_index_size_B, output + 2, previous);
+         }
+      }
+
+      output_triangle_base += scan.y;
+      if (tid == wg_size - 1)
+         *shared_segment_start = segment_start;
+      barrier(CLK_LOCAL_MEM_FENCE);
+      carried_segment_start = *shared_segment_start;
+   }
+}
