+static inline uint
+poly_work_group_segment_start(bool restart, uint tile_base,
+                              uint carried_segment_start,
+                              local void *scratch)
+{
+   const uint sg_size = get_sub_group_size();
+   const uint sg_id = get_sub_group_id();
+   const uint lane = get_sub_group_local_id();
+
+   uint4 ballot = sub_group_ballot(restart);
+
+   /* Do not overwrite ballot storage until every subgroup has finished the
+    * previous tile, then publish one complete ballot per subgroup. */
+   barrier(CLK_LOCAL_MEM_FENCE);
+   if (lane == 0)
+      poly_store_local_ballot_arr(scratch, sg_id, ballot);
+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   int search_sg = sg_id;
+   uint latest_lane = poly_ballot_find_msb_upto(ballot, lane);
+   while (latest_lane == UINT32_MAX && search_sg > 0) {
+      --search_sg;
+      ballot = poly_load_local_ballot_arr(scratch, search_sg);
